# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Public values (safe to be visible in the browser — your data is protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SECRET — server only. Never prefix with NEXT_PUBLIC_, never commit, never paste in chat.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# The exact address of your app (used to build invite links). No trailing slash.
APP_URL=http://localhost:3000

# Maximum number of accounts (including you) the app will allow.
MAX_USERS=15
